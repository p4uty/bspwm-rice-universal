# Set environment variables
export PATH="$HOME/.config/bspwm/bin:$HOME/.local/bin:$PATH"
export XDG_CURRENT_DESKTOP='bspwm'
## Fix java applications
export _JAVA_AWT_WM_NONREPARENTING=1

#  ╦ ╦╔═╗╦═╗╦╔═╔═╗╔═╗╔═╗╔═╗╔═╗╔═╗
#  ║║║║ ║╠╦╝╠╩╗╚═╗╠═╝╠═╣║  ║╣ ╚═╗
#  ╚╩╝╚═╝╩╚═╩ ╩╚═╝╩  ╩ ╩╚═╝╚═╝╚═╝

MonitorSetup

#  ╔╗ ╔═╗╔═╗╦ ╦╔╦╗  ╔═╗╔═╗╔╗╔╔═╗╦╔═╗
#  ╠╩╗╚═╗╠═╝║║║║║║  ║  ║ ║║║║╠╣ ║║ ╦
#  ╚═╝╚═╝╩  ╚╩╝╩ ╩  ╚═╝╚═╝╝╚╝╚  ╩╚═╝

bspc config external_rules_command "${HOME}"/.config/bspwm/bin/ExternalRules

bspc config window_gap                5
bspc config split_ratio               0.51
bspc config single_monocle            true
bspc config borderless_monocle        true

bspc config automatic_scheme          longest_side
bspc config initial_polarity          second_child
bspc config removal_adjustment        true

bspc config focus_follows_pointer     true
bspc config pointer_follows_focus     false
bspc config pointer_follows_monitor   true
bspc config pointer_motion_interval   7
bspc config pointer_modifier          mod4
bspc config pointer_action1           move
bspc config pointer_action2           resize_side
bspc config pointer_action3           resize_corner

#  ╔═╗╦ ╦╔╦╗╔═╗╔═╗╔╦╗╔═╗╦═╗╔╦╗
#  ╠═╣║ ║ ║ ║ ║╚═╗ ║ ╠═╣╠╦╝ ║
#  ╩ ╩╚═╝ ╩ ╚═╝╚═╝ ╩ ╩ ╩╩╚═ ╩

run() {
  if ! pidof -q "$1"; then
    "$@" &
  fi
}

# Set system vars for polybar
"$HOME"/.config/bspwm/bin/SetSysVars

# Launch sxhkd daemon
run sxhkd -c "${HOME}"/.config/bspwm/config/sxhkdrc

# Launch dunst (notificaciones) - el modulo del tema solo hace 'dunstctl reload'
run dunst

# Load current theme
"${HOME}"/.config/bspwm/bin/Theme.sh

# Launch picom
run picom --config "${HOME}"/.config/bspwm/config/picom/picom.conf

# Launch xsettingsd
run xsettingsd --config="${HOME}"/.config/bspwm/config/xsettingsd >/dev/null 2>&1

# Launch eww daemon (solo si eww esta instalado/compilado)
command -v eww >/dev/null 2>&1 && { pidof -q eww || { eww -c "${HOME}"/.config/bspwm/eww daemon & }; }

# Launch clipboard daemon (opcional: solo si clipcat esta instalado)
command -v clipcatd >/dev/null 2>&1 && run clipcatd

# Launch polkit: usa el primer agente disponible (la ruta cambia entre distros)
for agent in "$(command -v lxpolkit)" \
    /usr/libexec/polkit-gnome-authentication-agent-1 \
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
    /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 \
    /usr/libexec/polkit-mate-authentication-agent-1 \
    /usr/lib/x86_64-linux-gnu/polkit-mate/polkit-mate-authentication-agent-1 \
    /usr/libexec/kf6/polkit-kde-authentication-agent-1 \
    /usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1; do
    if [ -n "$agent" ] && [ -x "$agent" ]; then
        pgrep -f "$(basename "$agent")" >/dev/null || "$agent" &
        break
    fi
done

# Auto-guardar el wallpaper por rice (persiste tras reiniciar)
pgrep -f "bspwm/bin/WallWatch" >/dev/null || "$HOME"/.config/bspwm/bin/WallWatch &

# Start one time message
[ ! -f "$HOME/.config/bspwm/config/.first_run_done" ] && alacritty --hold -e sh -c 'cat "$HOME/.config/bspwm/config/FirstMessage.txt"; sleep 0.1' && touch "$HOME/.config/bspwm/config/.first_run_done"
