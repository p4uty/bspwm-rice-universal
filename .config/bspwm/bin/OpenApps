WIDGET_DIR="$HOME/.config/bspwm/eww"

# Lanza la primera app disponible de la lista (los nombres cambian entre distros)
first_of() {
	for app in "$@"; do
		command -v "$app" >/dev/null 2>&1 && { exec "$app"; }
	done
	dunstify -u low "OpenApps" "No se encontró ninguna de: $*"
}

case "$1" in
	--menu)
		RofiLauncher --launcher
		;;
	--rice)
		RiceSelector
		;;
	--terminal)
		Term --terminal
		;;
	--floating)
		Term --floating
		;;
	--update)
		Term --update
		;;
	--checkupdates)
		Term --checkupdates
		;;
	--netmanager)
		NetManagerDM
		;;
	--bluetooth)
		rofi-bluetooth
		;;
	--screenshot)
		ScreenShoTer
		;;
	--powermenu)
		PowerMenu
		;;
	--keyboard)
		KeyBoardL
		;;
	--yazi)
		Term --yazi
		;;
	--nvim)
		Term --nvim
		;;
	--fetch)
		Term --fetch
		;;
	--scratch)
		Bspwm-ScratchPad
		;;
		# Apps
	--filemanager)
		thunar
		;;
	--browser)
		first_of brave-browser brave firefox chromium google-chrome-stable xdg-open
		;;
	--editor)
		geany
		;;
	--telegram)
		first_of telegram-desktop Telegram
		;;
	--whats)
		xdg-open https://web.whatsapp.com/
		;;
	--calculator)
		first_of gnome-calculator kcalc galculator qalculate-gtk mate-calc xcalc
		;;
	--soundcontrol)
		pavucontrol
		;;
		# Eww Widgets
	--KeyHelp)
		eww -c "$WIDGET_DIR" open --toggle csheet
		;;
	--usercard)
		eww -c "$WIDGET_DIR" open --toggle launchermenu
		;;
	*)
		echo "Invalid Option"
		;;
esac
